# ============ IM-Agent Gateway 配置模板 ============
# 使用方法：复制本文件为 .env 并按需修改。
# 保密凭证（BOT_ID / SECRET / API_KEY / MAKERS_MODELS_KEY / QODERCN_PERSONAL_ACCESS_TOKEN）
# 建议放在项目上一级目录的 .env，不随项目文件分发；
# 同名配置优先级：系统环境变量 > 上一级目录 .env > 项目 .env > 代码默认值。

# ============ 平台接入声明 ============
# 加载哪些 IM 通道（逗号分隔）：短名 = channels/ 目录下的包名；或 "模块路径:类名"（任意第三方包）。
# 通道模块需暴露 Channel 类（IMChannel 子类，构造签名 Channel(cfg)）
# 内置通道：wecom=企业微信、feishu=飞书（可只用其中一个，也可多个并存）
CHANNELS = "wecom,feishu"
# 加载哪些 Agent：短名 = agents/ 目录下的包名；或 "模块路径:类名"。
# Agent 模块需暴露 Agent 类（BaseAgent 子类，构造签名 Agent(cfg)）
AGENTS = "siliconflow,qoder,workbuddy,trae"
# Agent 初始开关（注册名逗号分隔；留空 = 全部启用；运行中可 /agent on|off 调整）
ENABLED_AGENTS = ""

# ============ 企业微信智能机器人（长连接模式） ============
# BOT_ID / SECRET 为保密凭证，放上一级目录 .env
# 长连接地址（一般无需修改）
WECOM_WS_URL = "wss://openws.work.weixin.qq.com"

# ============ 飞书机器人（企业自建应用，长连接接收事件模式） ============
# FEISHU_APP_ID / FEISHU_APP_SECRET 为保密凭证，放上一级目录 .env
# 需在飞书开放平台后台：开启机器人能力、订阅 im.message.receive_v1 事件、
# 申请消息读取权限，并选择「使用长连接接收事件」订阅方式。

# ============ Qoder CN 编码 Agent ============
# 编码任务的工作目录（Git 仓库），留空默认项目根目录
QODER_CWD = ""
# 使用的模型，留空则用 CLI 默认模型
QODER_MODEL = ""
# 权限模式：accept_edits=自动接受文件编辑（编码必备）；default=编辑需确认（无头模式下不可用）
QODER_PERMISSION_MODE = "accept_edits"
# 单次任务最长运行时间（秒），超时会终止进程
QODER_TIMEOUT_SEC = "1800"
# 单次回复最大输出 token 数
QODER_MAX_OUTPUT_TOKENS = "8000"
# qoderclicn 可执行文件路径（默认走 PATH）
QODER_BIN = "qoderclicn"
# 命名工作区列表，/ws 命令可列出与切换；格式：名称=路径;名称2=路径2（只写路径则用目录名）
WORKSPACES = "demo=D:/work/demo"
# Personal Access Token（可选，与交互式登录二选一），token 值放上一级目录 .env
QODERCN_PERSONAL_ACCESS_TOKEN = ""

# ============ 安全 ============
# 允许使用机器人的企微 userid 白名单，逗号分隔；留空表示不限制
ALLOWED_USERS = ""

# ============ 消息回复 ============
# 流式消息推送的最小间隔（秒），企微限流 30 条/分钟
STREAM_INTERVAL_SEC = "1.0"
# 每次推送的最大字符数
STREAM_CHUNK_SIZE = "200"
# 心跳间隔（秒），官方建议 30
HEARTBEAT_INTERVAL_SEC = "30"

# ============ 日志 ============
LOG_LEVEL = "INFO"

# ============ SiliconFlow（OpenAI 兼容对话 API） ============
# API_KEY 为保密凭证，放上一级目录 .env
# API 地址（默认 https://api.siliconflow.cn/v1）
SF_BASE_URL = "https://api.siliconflow.cn/v1"
# 默认模型（完整列表可发 /models 查看）
SF_MODEL = "deepseek-ai/DeepSeek-V4.1-Flash"
# 单次回复最大输出 token
SF_MAX_TOKENS = "4096"
# 单次请求超时（秒）
SF_TIMEOUT_SEC = "300"
# 是否把思维链内容也推送出去（1=是 0=否）
SF_INCLUDE_REASONING = "0"

# ============ WorkBuddy（腾讯办公 Agent，CLI：@tencent-ai/codebuddy-code） ============
# 默认模型，留空用 CLI 默认
WORKBUDDY_MODEL = ""
# 办公任务的工作目录，留空默认项目根目录
WORKBUDDY_CWD = ""
# 权限模式：acceptEdits=自动接受编辑；auto/dontAsk=跳过确认；plan=只读计划
WORKBUDDY_PERMISSION_MODE = "acceptEdits"
# 单次任务最长运行时间（秒），超时会终止进程
WORKBUDDY_TIMEOUT_SEC = "1800"
# codebuddy 可执行文件路径（默认走 PATH）
WORKBUDDY_BIN = "codebuddy"

# ============ Trae 编码 Agent（开源版：bytedance/trae-agent） ============
# 安装：git clone https://github.com/bytedance/trae-agent + uv sync --all-extras
# trae-cli 可执行文件（uv sync 后位于 .venv\Scripts）
TRAE_BIN = "trae-cli"
# 编码任务的工作目录，留空默认项目根目录
TRAE_CWD = ""
# trae 配置文件（模型端点等；API 凭证经环境变量注入，不写进文件）
TRAE_CONFIG = "trae_config_local.json"
# 模型，留空用 trae 配置文件默认
TRAE_MODEL = ""
# 轨迹文件目录（任务进度与结果的提取来源）
TRAE_TRAJ_DIR = ""
# 单次任务最长运行时间（秒），超时会终止进程
TRAE_TIMEOUT_SEC = "1800"

# ============ 消息路由 ============
# 默认 Agent：siliconflow=聊天 qoder=编码 workbuddy=办公（可用 /agent 命令按会话切换）
DEFAULT_AGENT = "siliconflow"
# 自动路由：1=开 0=关（开启后由 Jev 决策模型路由，不可用时降级为编码关键词正则）
AUTO_ROUTE = "1"

# ============ Agent 用途与难度分档 ============
# 给 Agent 指定用途（office 办公 / chat 对话 / coding 编码），自动选路按用途匹配。
# 格式：名称=用途，逗号分隔；不配置的 Agent 用其内置默认用途（如 workbuddy=office）
AGENT_KINDS = ""
# 同一用途配了多个 Agent 时，按问题难度分档。
# 格式：名称=档位（simple 简单 / mid 中等 / complex 复杂），逗号分隔
AGENT_COMPLEXITY = ""
# 难度自动选择：1=同一用途的多个 Agent 由 Jev 按问题难度挑一个（需配置 Jev）；
# 0=取 .env 里 AGENTS 声明顺序最前面的那个
COMPLEXITY_ROUTE = "0"

# ============ 消息唤醒 / 看门狗（Wake on Message） ============
# 看门狗总开关：1=由 watcher.py 监听消息、收到消息后唤醒完整服务；0=看门狗启动即退出（默认）。
# 是否随开机启动由下面的 WATCH_AUTOSTART 单独控制。
# 注意：WATCH_ENABLED=1 时应由 watcher.py 常驻监听、不要再手动长期运行 main.py，二者会抢同一条长连接。
WATCH_ENABLED = "0"
# 开机自动启动看门狗：1=登录电脑后静默启动 watcher.py（默认；计划任务用 pythonw 启动，不会弹窗口）；
# 0=不随开机启动（计划任务仍保留，登录后读配置即退出，下次开机生效）。
WATCH_AUTOSTART = "1"
# 服务空闲自动退开关：1=服务空闲超过 IDLE_EXIT_MIN 分钟后自动退出，交还看门狗；0=服务常驻（默认）。
# 两开关相互独立：只开 IDLE_EXIT 不开 WATCH_ENABLED 时，服务空闲退出后不会有人重新唤醒。
IDLE_EXIT = "0"
# 空闲判定分钟数（仅 IDLE_EXIT=1 生效）
IDLE_EXIT_MIN = "10"
# 看门狗收到唤醒消息时先回的这个占位文案（随后服务起来再回正式处理结果）
WAKE_REPLY = "正在唤醒…"
# 看门狗拉起服务所用的命令（在本项目根目录下执行）
SERVICE_CMD = "python main.py"
# 唤醒消息交接文件路径（相对项目根；看门狗写入、服务启动时读取并删除）
WAKE_HANDOFF_FILE = ".wake_pending.json"
# 睡眠态托管开关：1=服务睡眠期间由看门狗占住 WEBUI_PORT 托管控制台页面，
# 页面显示「服务正在休息」并提供一键唤醒；0=睡眠期间页面不可达（默认）。
# 需与 WATCH_ENABLED=1 搭配使用；HTTP 被动型通道（如 webui）看门狗自动跳过监听。
WATCH_HTTP_ENABLED = "0"

# ============ Web 控制台（webui 通道：管理台 + 聊天台） ============
# webui 通道接入开关：1=浏览器作为第三个 IM 接入（自动并入 CHANNELS，默认）；0=不接入
WEBUI_ENABLED = "1"
# HTTP 绑定地址（默认仅本机可访问；不要填 0.0.0.0 暴露公网）
WEBUI_HOST = "127.0.0.1"
# webui 通道与睡眠态托管共用的端口
WEBUI_PORT = "8790"
# 浏览器会话的 user_id（参与 ALLOWED_USERS 白名单校验：设了白名单就须包含本值）
WEBUI_USER_ID = "webui"
# 控制台静态目录（留空 = 使用项目根 webui/ 目录的页面，一般无需修改）
WEBUI_STATIC = ""

# ============ Jev（System One 决策模型，经 Makers 网关调用，用于消息 Agent 路由） ============
# MAKERS_MODELS_KEY 为保密凭证，放上一级目录 .env
# Makers 网关地址（支持 /v1/systemone 决策端点）
JEV_BASE_URL = "https://ai-gateway.edgeone.link/v1"
# 模型 ID（Makers 网关固定为 @makers/jev）
JEV_MODEL = "@makers/jev"
# 是否用 Jev 决策路由（1=开 0=关；调用失败自动降级关键词路由，不影响收发）
JEV_ROUTE = "1"
# 单次决策请求超时（秒）
JEV_TIMEOUT_SEC = "6"
# 置信度阈值：Jev 结果低于该值时不用，走默认 Agent
JEV_MIN_CONFIDENCE = "0.5"
